root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

# Tests start with the ID they cover: RF04_readsTheSlug, FEAT001_...
[{**/commonTest/**,**/jvmTest/**,**/iosTest/**,**/androidHostTest/**,**/test/**,**/androidTest/**}]
ktlint_standard_function-naming = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.swift]
indent_size = 4
