<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only reaches the user's own servers on the local network; the code blocks it elsewhere (§6). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
