<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist: only what the INFOPLIST_KEY_ settings cannot express. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pt-BR</string>
		<string>es</string>
	</array>
	<!-- Servers on the user's own network may be plain HTTP (architecture, security: RFC 1918 and .local only). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- RNF-28: the download queue keeps going when the system gives the app time in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tiagohs.hqr.reader.downloads</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
