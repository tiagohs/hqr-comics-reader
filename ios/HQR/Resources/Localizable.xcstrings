    "backup_create_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library, categories, chapters read, progress, history, settings and servers. Passwords stay out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca, categorías, capítulos leídos, progreso, historial, ajustes y servidores. Las contraseñas quedan fuera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca, categorias, capítulos lidos, progresso, histórico, ajustes e servidores. As senhas ficam de fora."
          }
        }
      }
    },
    "backup_newer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup comes from a newer HQR. Update the app to restore it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia viene de un HQR más nuevo. Actualiza la app para restaurarla."
