    "about_no_content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HQR hosts no content. It shows what the sources and your own files offer; the rights belong to their authors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HQR no aloja contenido. Muestra lo que ofrecen las fuentes y tus archivos; los derechos son de sus autores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HQR não hospeda conteúdo. Ele mostra o que as fontes e os seus arquivos oferecem; os direitos são dos autores."
          }
        }
      }
    },
    "about_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "es": {
          "stringUnit": {
