          }
        }
      }
    },
    "about_privacy_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full privacy policy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidad completa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Política de privacidade completa"
          }
        }
      }
    },
    "about_privacy_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library, progress and files stay on this device. HQR has no account and no analytics; Android sends only crash reports (stack, device model, install id). The sources you open see your requests, as any website would."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, progreso y archivos quedan en este dispositivo. HQR no tiene cuenta ni analytics; en Android solo envía informes de fallos (traza, modelo del dispositivo, id de instalación). Las fuentes que abres ven tus solicitudes, como cualquier sitio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca, progresso e arquivos ficam neste aparelho. O HQR não tem conta nem analytics; no Android, só envia relatórios de falha (rastro, modelo do aparelho, id de instalação). As fontes que você abre veem os seus pedidos, como qualquer site."
          }
        }
      }
    },
    "about_privacy_text_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library, progress and files stay on this device. HQR has no account, no analytics and no crash reports on iPhone and iPad. The sources you open see your requests, as any website would."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca, tu progreso y tus archivos se quedan en este dispositivo. HQR no tiene cuenta, analíticas ni informes de fallos en iPhone y iPad. Las fuentes que abres ven tus solicitudes, como cualquier sitio web."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca, seu progresso e seus arquivos ficam neste aparelho. O HQR não tem conta, analytics nem relatórios de falha no iPhone e no iPad. As fontes que você abre veem seus pedidos, como qualquer site."
          }
        }
      }
    },
