{
  "sourceLanguage": "en",
  "strings": {
    "about_based_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading logic inspired by Mihon and TachiyomiSY (Apache License 2.0). NOTICE: Copyright © 2015 Javier Tomás, © 2024 Mihon Open Source Project, © TachiyomiSY contributors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lógica de lectura inspirada en Mihon y TachiyomiSY (Apache License 2.0). NOTICE: Copyright © 2015 Javier Tomás, © 2024 Mihon Open Source Project, © colaboradores de TachiyomiSY."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lógica de leitura inspirada no Mihon e no TachiyomiSY (Apache License 2.0). NOTICE: Copyright © 2015 Javier Tomás, © 2024 Mihon Open Source Project, © colaboradores do TachiyomiSY."
          }
        }
      }
    },
    "about_credit_hqnow": {
      "extractionState": "manual",
      "localizations": {
