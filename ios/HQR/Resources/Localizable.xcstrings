    "bridge_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the browser, MangaDex and HQ Now only open through your own bridge: a small free Cloudflare Worker you publish. It stores nothing and only forwards to the sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el navegador, MangaDex y HQ Now solo abren por tu propio puente: un Worker gratis de Cloudflare que publicas. No guarda nada y solo reenvía a las fuentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No navegador, o MangaDex e o HQ Now só abrem pela sua própria ponte: um Worker grátis do Cloudflare que você publica. Ela não guarda nada e só repassa para as fontes."
          }
        }
      }
    },
