        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos e imágenes de MangaDex (mangadex.org), traducidos por los grupos acreditados en cada capítulo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados e imagens do MangaDex (mangadex.org), traduzidos pelos grupos creditados em cada capítulo."
          }
        }
      }
    },
