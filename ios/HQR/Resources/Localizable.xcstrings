    "server_problem_cleartext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside your home network, use an https:// address: with http the password would travel unprotected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de tu red de casa, usa una dirección https://: con http la contraseña viajaría sin protección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora da sua rede de casa, use um endereço https://: com http a senha viajaria sem proteção."
          }
        }
      }
    },
    "server_problem_cors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't allow this address. In Komga or Kavita, add %1$@ to the allowed origins (CORS) and test again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no permitió esta dirección. En Komga o Kavita, agrega %1$@ a los orígenes permitidos (CORS) y prueba de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não liberou este endereço. No Komga ou no Kavita, adicione %1$@ às origens permitidas (CORS) e teste de novo."
          }
        }
      }
    },
    "server_problem_credentials_in_address": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the user and password in their own fields, not in the address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el usuario y la contraseña en sus campos, no en la dirección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque usuário e senha nos campos próprios, não no endereço."
          }
        }
      }
    },
    "server_problem_invalid_address": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an address that starts with http:// or https://."
