    "server_problem_mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The web app runs on https and the browser blocks http servers. Open the server through https (a reverse proxy or the Komga/Kavita https address)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app web corre en https y el navegador bloquea servidores http. Abre el servidor por https (un proxy inverso o la dirección https de Komga o Kavita)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app web roda em https e o navegador bloqueia servidores http. Abra o servidor por https (um proxy reverso ou o endereço https do Komga ou do Kavita)."
          }
        }
      }
    },
    "server_problem_not_opds": {
