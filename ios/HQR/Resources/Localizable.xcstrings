          }
        }
      }
    },
    "about_credit_mangadex": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data and images from MangaDex (mangadex.org), translated by the scan groups credited in each chapter."
